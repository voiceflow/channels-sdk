# Copy to .env.local. connect fills in the Teams values (npm run connect).

# Your Voiceflow agent: Settings > API keys, and the project's ID.
VOICEFLOW_API_KEY=
VOICEFLOW_PROJECT_ID=
# The environment the bot talks to. It runs that environment's published version.
VOICEFLOW_ENVIRONMENT=development

# The Teams bot: its app's ID, its secret, and your Microsoft 365 organization's ID.
# connect has Microsoft make them and writes them here.
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_APP_TENANT_ID=

# Optional. Without it, conversations live in memory and end when the server restarts.
REDIS_URL=

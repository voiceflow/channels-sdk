# Copy to .env.local. You put in the bot's token; connect fills in the other Discord values (npm run connect).

# Your Voiceflow agent: Settings > API keys, and the project's ID.
VOICEFLOW_API_KEY=
VOICEFLOW_PROJECT_ID=
# The environment the bot talks to. It runs that environment's published version.
VOICEFLOW_ENVIRONMENT=development

# The Discord bot's token: discord.com/developers/applications > your app > Bot > Reset Token.
DISCORD_BOT_TOKEN=
# The app's public key and ID. connect reads them from Discord and writes them here.
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# Optional. Without it, conversations live in memory and end when the server restarts.
REDIS_URL=

# Deployed only: the secret your scheduler sends to /api/discord/gateway (see README, "Deploy it").
CRON_SECRET=

# Copy to .env.local. connect says which of these are still missing (npm run connect).

# Your Voiceflow agent: Settings > API keys, and the project's ID.
VOICEFLOW_API_KEY=
VOICEFLOW_PROJECT_ID=
# The environment the bot talks to. It runs that environment's published version.
VOICEFLOW_ENVIRONMENT=development

# Telegram. From Telegram's own pages: https://github.com/vercel/chat/tree/main/packages/adapter-telegram
# Telegram bot token.
TELEGRAM_BOT_TOKEN=
# The secret Telegram sends back with each message, which is how the server knows a message is Telegram's. Leave it empty: connect makes it.
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Optional. Without it, conversations live in memory and end when the server restarts.
REDIS_URL=

{
  "name": "voiceflow-channelkit",
  "version": "0.0.0",
  "private": true,
  "description": "Connect Voiceflow agents to Slack and other platforms through Vercel Chat SDK adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voiceflow/channelkit.git"
  },
  "homepage": "https://github.com/voiceflow/channelkit#readme",
  "bugs": {
    "url": "https://github.com/voiceflow/channelkit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "workspaces": [
    "packages/core",
    "packages/slack",
    "packages/discord",
    "packages/teams",
    "packages/gchat",
    "packages/github",
    "packages/gitlab",
    "packages/instagram",
    "packages/linear",
    "packages/messenger",
    "packages/notion",
    "packages/telegram",
    "packages/twilio",
    "packages/whatsapp",
    "packages/x",
    "packages/create",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome ci --error-on-warnings .",
    "fix": "biome check --write .",
    "validate": "npm run lint && npm run build && npm run typecheck && npm test",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --no-audit --no-fund",
    "release": "changeset publish",
    "channels": "node scripts/channels.mjs"
  },
  "overrides": {
    "gaxios": {
      "rimraf": "^6.1.4"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@changesets/cli": "3.0.3",
    "@chat-adapter/catalog": "4.45.0",
    "@chat-adapter/discord": "4.45.0",
    "@chat-adapter/gchat": "4.45.0",
    "@chat-adapter/github": "4.45.0",
    "@chat-adapter/gitlab": "4.45.0",
    "@chat-adapter/instagram": "4.45.0",
    "@chat-adapter/linear": "4.45.0",
    "@chat-adapter/messenger": "4.45.0",
    "@chat-adapter/notion": "4.45.0",
    "@chat-adapter/slack": "4.45.0",
    "@chat-adapter/state-memory": "4.45.0",
    "@chat-adapter/teams": "4.45.0",
    "@chat-adapter/telegram": "4.45.0",
    "@chat-adapter/twilio": "4.45.0",
    "@chat-adapter/whatsapp": "4.45.0",
    "@chat-adapter/x": "4.45.0",
    "@types/node": "22.20.5",
    "chat": "4.45.0",
    "typescript": "5.9.3"
  }
}

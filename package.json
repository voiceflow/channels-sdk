{
  "name": "voiceflow-channels",
  "version": "0.0.0",
  "private": true,
  "description": "Connect Voiceflow agents to Slack and other platforms through Vercel Chat SDK adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voiceflow/channels-sdk.git"
  },
  "homepage": "https://github.com/voiceflow/channels-sdk#readme",
  "bugs": {
    "url": "https://github.com/voiceflow/channels-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "packages/slack",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate": "npm run build && npm run typecheck && npm test",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --no-audit --no-fund",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@chat-adapter/catalog": "4.45.0",
    "@chat-adapter/slack": "4.45.0",
    "@chat-adapter/state-memory": "4.45.0",
    "@types/node": "20.19.25",
    "chat": "4.45.0",
    "typescript": "5.9.3"
  }
}

{
  "name": "@voiceflow/channels-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "The core of Voiceflow Channels: a Voiceflow agent inside any Vercel Chat SDK bot, on any adapter in the catalog.",
  "keywords": [
    "voiceflow",
    "chat",
    "chat-sdk",
    "vercel-chat",
    "chatbot",
    "bot",
    "ai-agent",
    "ai-agents",
    "conversational-ai",
    "messaging",
    "channels"
  ],
  "author": "Braden Ream",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voiceflow/channels-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/voiceflow/channels-sdk/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/voiceflow/channels-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./install": {
      "types": "./dist/install.d.ts",
      "import": "./dist/install.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "chat": ">=4.44.0 <5",
    "@chat-adapter/catalog": ">=4.44.0 <5"
  },
  "bin": {
    "voiceflow-channels": "./dist/cli.js"
  }
}

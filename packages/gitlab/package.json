{
  "name": "@voiceflow/channelkit-gitlab",
  "version": "0.0.0",
  "private": true,
  "description": "A Voiceflow agent in GitLab, with one command to set it up.",
  "keywords": [
    "voiceflow",
    "channelkit",
    "gitlab",
    "chat-sdk",
    "vercel-chat",
    "chatbot",
    "bot",
    "ai-agent",
    "conversational-ai"
  ],
  "author": "Braden Ream",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voiceflow/channelkit.git",
    "directory": "packages/gitlab"
  },
  "homepage": "https://github.com/voiceflow/channelkit/tree/main/packages/gitlab#readme",
  "bugs": {
    "url": "https://github.com/voiceflow/channelkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connect": {
      "types": "./dist/connect/index.d.ts",
      "import": "./dist/connect/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@voiceflow/channelkit": "0.0.0"
  },
  "peerDependencies": {
    "chat": ">=4.44.0 <5",
    "@chat-adapter/catalog": ">=4.44.0 <5",
    "@chat-adapter/gitlab": ">=4.44.0 <5",
    "@chat-adapter/state-memory": ">=4.44.0 <5"
  },
  "peerDependenciesMeta": {
    "@chat-adapter/state-memory": {
      "optional": true
    }
  }
}
